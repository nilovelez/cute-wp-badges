# Normalize line endings to LF in the repository and the working tree.
* text=auto eol=lf

# Binary files.
*.png binary
*.jpg binary
*.gif binary
*.eot binary
*.ttf binary

# Development files, excluded from `git archive` (the release zip).
# Add here any other file or folder that is not part of the plugin.
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.github         export-ignore
/.claude         export-ignore
/AGENTS.md       export-ignore
/CLAUDE.md       export-ignore
/README.md       export-ignore
/blueprint.json  export-ignore
/composer.json   export-ignore
/composer.lock   export-ignore
/phpcs.xml.dist  export-ignore
/package.json    export-ignore
/package-lock.json export-ignore
/assets          export-ignore
/assets-src      export-ignore
/docs            export-ignore
/guppy           export-ignore
/scripts         export-ignore
/preview.html    export-ignore

